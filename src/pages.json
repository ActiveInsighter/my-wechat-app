{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "AnyWorkflow",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/explore/explore",
      "style": {
        "navigationBarTitleText": "任务队列",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "连接与设置"
      }
    },
    {
      "path": "pages/task-editor/task-editor",
      "style": {
        "navigationBarTitleText": "任务编辑器"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "AnyWorkflow",
    "navigationBarBackgroundColor": "#F7F8F5",
    "backgroundColor": "#F7F8F5",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#8B928D",
    "selectedColor": "#143B36",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台"
      },
      {
        "pagePath": "pages/explore/explore",
        "text": "任务"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "设置"
      }
    ]
  }
}
